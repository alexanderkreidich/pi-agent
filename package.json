{
  "name": "pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable public configuration package for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexanderkreidich/pi-agent.git"
  },
  "homepage": "https://github.com/alexanderkreidich/pi-agent#readme",
  "bugs": {
    "url": "https://github.com/alexanderkreidich/pi-agent/issues"
  },
  "keywords": [
    "pi-package",
    "coding-agent",
    "ai-agent"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^24.1.3",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/bookmark.ts",
      "extensions/brave-web/index.ts",
      "extensions/confirm-destructive.ts",
      "extensions/github-issue-autocomplete.ts",
      "extensions/handoff.ts",
      "extensions/notify.ts",
      "extensions/pi-diff-viewer/index.ts",
      "extensions/preset.ts",
      "extensions/prompt-url-widget.ts",
      "extensions/protected-paths.ts",
      "extensions/qna.ts",
      "extensions/redraws.ts",
      "extensions/rtk.ts",
      "extensions/session-name.ts",
      "extensions/subagent/index.ts",
      "extensions/tools.ts",
      "extensions/tps.ts",
      "extensions/zz-git-branch-editor-label.ts"
    ],
    "skills": [
      "skills"
    ],
    "prompts": [
      "prompts/is.md",
      "prompts/wr.md"
    ],
    "themes": [
      "themes"
    ]
  }
}
